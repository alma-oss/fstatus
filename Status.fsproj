<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.Status</PackageId>
    <Version>2.0.0</Version>
    <Authors>Almacareer</Authors>
    <Description>F# library for running health checks, aggregating system status, tracking status changes, and collecting incident history.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alma-oss/fstatus.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alma-oss/fstatus</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/HealthCheck.fs" />
    <Compile Include="src/ServiceCheck.fs" />
    <Compile Include="src/StreamLagSeverity.fs" />
    <Compile Include="src/StatusStorage.fs" />
    <Compile Include="src/History/History.fs" />
    <Compile Include="src/IncidentManagement.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>
